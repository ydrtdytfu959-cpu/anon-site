# Catalog/detail guardrails, supplementing least-privilege template assertions.
let tables = Resources.*[ Type == 'AWS::DynamoDB::Table' ]
rule catalog_cache_is_expiring_and_encrypted when %tables !empty {
  %tables {
    DeletionPolicy == 'Retain'
    UpdateReplacePolicy == 'Retain'
    Properties.BillingMode == 'PAY_PER_REQUEST'
    Properties.TimeToLiveSpecification.Enabled == true
    Properties.TimeToLiveSpecification.AttributeName == 'expiresAt'
    Properties.SSESpecification.SSEEnabled == true
    Properties.DeletionProtectionEnabled == true
    Properties.PointInTimeRecoverySpecification.PointInTimeRecoveryEnabled == true
  }
}
rule runtime_scope {
  Resources.Channel3Function.Properties.Runtime == 'nodejs24.x'
  Resources.Channel3Function.Properties.Timeout == 20
  Resources.Channel3Role.Properties.Policies.*.PolicyDocument.Statement.* {
    Effect == 'Allow'
    Resource is_struct
    Action[*] IN ['secretsmanager:GetSecretValue', 'dynamodb:GetItem', 'dynamodb:PutItem', 'dynamodb:DeleteItem', 'dynamodb:UpdateItem', 'logs:CreateLogStream', 'logs:PutLogEvents']
  }
}
rule detail_route_scope {
  Resources.DetailRoute.Properties.RouteKey == 'GET /catalog/channel3/products/{id}'
  Resources.DetailRoute.Properties.AuthorizationType == 'NONE'
  Resources.DetailPermission.Properties.Principal == 'apigateway.amazonaws.com'
  Resources.DetailPermission.Properties.SourceAccount is_struct
  Resources.DetailPermission.Properties.SourceArn is_struct
  Resources.DetailIntegration.Properties.PayloadFormatVersion == '2.0'
}

rule explicit_spending_policy {
  Parameters.BudgetMonth.Default == ''
  Parameters.NextBudgetMonth.Default == ''
  Parameters.FreeSearchMonthlyCredits.Default == 0
  Parameters.PaidUsageEnabled.Default == 'false'
  Parameters.PaidSearchMonthlyCredits.Default == 0
  Parameters.SearchDailyLimit.Default == 0
  Parameters.DetailMonthlyLimit.Default == 0
  Parameters.DetailDailyLimit.Default == 0
}

rule private_budget_monitor {
  Resources.BudgetMonitorPermission.Properties.Principal == 'events.amazonaws.com'
  Resources.BudgetMonitorPermission.Properties.SourceAccount is_struct
  Resources.BudgetMonitorPermission.Properties.SourceArn is_struct
  Resources.BudgetMonitorSchedule.Properties.ScheduleExpression == 'rate(1 hour)'
  Resources.BudgetMonitorMissingAlarm.Properties.TreatMissingData == 'breaching'
}
